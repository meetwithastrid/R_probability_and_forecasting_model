# definisikan alpha prior
alpha_prior <- 6

# definisikan beta prior
beta_prior <- 359

# definisikan jumlah kejadian gempa tahun 2015 hingga 2024
k <- 538

# definisikan jumlah hari tahun 2015 hingga 2024
N <- 3652

# menghitung alpha posterior
alpha_posterior <- alpha_prior + k

# menghitung beta posterior
beta_posterior <- beta_prior + (N - k)

# menghitung rata-rata posterior
mean_posterior <- alpha_posterior / (alpha_posterior + beta_posterior)

# definisikan CI yang digunakan
credible_interval <- qbeta(c(0.025, 0.975), alpha_posterior, beta_posterior)

# menampilkan hasil estimasi peluang gempa harian
cat("Estimasi Peluang Gempa per Hari (Mean Posterior):", mean_posterior, "\n")

# menampilkan hasil CI
cat("95% Credible Interval:", credible_interval, "\n")

# memanggil packages untuk membuat plot distribusi posterior
library(ggplot2)

# definisikan rentang nilai untuk sumbu x
theta_vals <- seq(0, 0.2, length.out = 1000)

# menghitung nilai densitas dari hasil posterior
posterior_vals <- dbeta(theta_vals, alpha_posterior, beta_posterior)

# definisikan data frame yang berisi nilai densitas
posterior_df <- data.frame(theta = theta_vals, density = posterior_vals)

# membangun plot distribusi posterior
ggplot(posterior_df, aes(x = theta, y = density)) +
  geom_line(color = "blue", size = 1) +
  ggtitle("Distribusi Posterior Untuk Peluang Gempa Jawa Timur") +
  xlab("Peluang Gempa (" ~ theta ~ ")") +
  ylab("Densitas") +
  theme_minimal()
